# Copy to ".env" on the server and fill in real values:  cp .env.example .env
# NEVER commit ".env" to git.

# Public domain whose DNS A record points to the server (HTTPS certificate is issued for it).
DOMAIN=shakhdict.duckdns.org

# PostgreSQL (the database is created automatically on first start).
POSTGRES_DB=dictionary
POSTGRES_USER=dictionary
# Generate:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT signing key, Base64, >= 32 bytes. Generate:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_BASE64_SECRET

# Access token lifetime (ms, 15 min) and refresh token lifetime (ms, 30 days).
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Optional
TZ=Asia/Tashkent
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
